{
  "schema": "wp-codebox/workspace-recipe/v1",
  "runtime": { "backend": "wordpress-playground", "name": "link-page-storage-migration-parity", "wp": "latest" },
  "inputs": {
    "services": [{
      "id": "wordpress-database",
      "kind": "mysql",
      "configuration": { "provider": "native", "engine": "mariadb" },
      "outputs": { "host": "DB_HOST", "port": "DB_PORT", "username": "DB_USER", "password": "DB_PASSWORD", "database": "DB_NAME" }
    }],
    "mounts": [
      { "source": "/var/lib/datamachine/workspace/extrachill-link-pages@feat-11-storage-migration", "target": "/tmp/pr/link-pages", "mode": "readonly", "metadata": { "kind": "component", "slug": "link-pages" } },
      { "source": "/var/lib/datamachine/workspace/extrachill-artist-platform@feat-205-link-page-migration", "target": "/tmp/pr/artist", "mode": "readonly", "metadata": { "kind": "component", "slug": "artist" } },
      { "source": "/var/lib/datamachine/workspace/extrachill-analytics@feat-257-link-page-migration", "target": "/tmp/pr/analytics", "mode": "readonly", "metadata": { "kind": "component", "slug": "analytics" } },
      { "source": "/var/lib/datamachine/workspace/extrachill-cli@feat-141-link-page-migration", "target": "/tmp/pr/cli", "mode": "readonly", "metadata": { "kind": "component", "slug": "cli" } },
      { "source": "/var/lib/datamachine/workspace/extrachill-network", "target": "/tmp/pr/network", "mode": "readonly", "metadata": { "kind": "dependency", "slug": "network" } },
      { "source": "/var/lib/datamachine/workspace/extrachill-users", "target": "/tmp/pr/users", "mode": "readonly", "metadata": { "kind": "dependency", "slug": "users" } }
    ]
  },
  "workflow": {
    "steps": [
      { "command": "wordpress.wp-cli", "args": ["command=wp core multisite-convert --title='Migration Proof Network' --base=/"] },
      { "command": "wordpress.wp-cli", "args": ["command=wp eval-file /tmp/pr/cli/tests/integration/storage-migration-multisite.php"] }
    ]
  },
  "artifacts": { "directory": "/mnt/extrachill-workspace/tmp/opencode/link-page-migration-parity" }
}
